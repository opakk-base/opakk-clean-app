{
  "name": "electron-cleaner",
  "version": "1.0.0",
  "description": "Electron app to clean junk/cache files and find large files",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "build:ts": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "npm run build:ts && electron .",
    "dist": "npm run build:ts && electron-builder --publish never",
    "dist:mac": "npm run build:ts && electron-builder --mac dmg zip --universal --publish never",
    "dist:win": "npm run build:ts && electron-builder --win --publish never",
    "dist:linux": "npm run build:ts && electron-builder --linux --publish never"
  },
  "keywords": [
    "electron",
    "cleaner",
    "cache",
    "disk"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.3.3",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.rizal.electroncleaner",
    "productName": "Electron Cleaner",
    "files": [
      "dist-electron/**/*",
      "index.html",
      "styles.css",
      "package.json",
      "core/**/*",
      "features/**/*",
      "static/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
